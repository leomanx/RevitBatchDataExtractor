<Window x:Class="RBDE.CloudApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APS Cloud Batch Extractor (MMK BIM)"
        Height="860" Width="1240" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B132B" Foreground="#F8FAFC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Card Container Style -->
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#1C2541"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D3B60"/>
        </Style>

        <!-- Clean Checkbox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- High-Contrast ComboBox Style (Black Text) -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#3A506B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Action Button Style -->
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Background" Value="#2D3B60"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Application Workspace -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <Border Grid.Row="0" Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="APS Cloud Batch Extractor" FontSize="18" FontWeight="Bold" Foreground="#6FFFE9"/>
                            <Border Background="#102A43" BorderBrush="#00838F" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="Model Derivative REST" FontSize="10" FontWeight="SemiBold" Foreground="#4DD0E1"/>
                            </Border>
                            <Border Background="#102A43" BorderBrush="#3A506B" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="6,0,0,0">
                                <TextBlock Text="Multi-Discipline AEC Schema" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Extract categories, family types, quantities, and custom parameters directly from Autodesk Construction Cloud for QA/QC and BI Visualization."
                                   FontSize="12" Foreground="#8D99AE" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtHubName" Text="Hub: Disconnected" FontSize="11" FontWeight="SemiBold" Foreground="#6FFFE9" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TxtStatusBadge" Text="Initializing..." FontSize="10" Foreground="#8D99AE" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Button x:Name="BtnOpenSettings" Content="Configure Credentials" Style="{StaticResource SecondaryBtn}" Click="BtnOpenSettings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area (2 Columns) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Hierarchy & Model Selection -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Hub / Project / Folder Selection -->
                    <Border Grid.Row="0" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Project Navigation" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8"/>

                            <TextBlock Text="Hub:" FontSize="11" Foreground="#8D99AE" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbHubs" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectionChanged="CmbHubs_SelectionChanged" Margin="0,0,0,8"/>

                            <TextBlock Text="Project:" FontSize="11" Foreground="#8D99AE" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbProjects" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectionChanged="CmbProjects_SelectionChanged" Margin="0,0,0,8"/>

                            <TextBlock Text="Folder (Project Files):" FontSize="11" Foreground="#8D99AE" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbFolders" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectionChanged="CmbFolders_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Models List Card -->
                    <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="RVT Models in Folder" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtSelectedCount" Text="Selected: 0 models" FontSize="11" Foreground="#6FFFE9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Select All" Style="{StaticResource SmallBtn}" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
                                <Button Content="Deselect All" Style="{StaticResource SmallBtn}" Margin="0,0,6,0" Click="BtnClearSelection_Click"/>
                                <Button x:Name="BtnDiscoverSchema" Content="Scan Model Schema" Style="{StaticResource SmallBtn}"
                                        Background="#1E3A5F" Foreground="#6FFFE9" Click="BtnDiscoverSchema_Click"
                                        ToolTip="Inspect categories and parameters present in the first selected RVT model"/>
                            </StackPanel>

                            <Border Grid.Row="2" Background="#0B132B" CornerRadius="4" Padding="4">
                                <ListView x:Name="LstModels" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,4" BorderBrush="#1C2541" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                                              Checked="ModelCheck_Changed" Unchecked="ModelCheck_Changed" Margin="0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="#E2E8F0"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="#8D99AE"
                                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RIGHT COLUMN: AEC Schema Configuration, Actions & Console -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Category Scope & Discipline Presets -->
                    <Border Grid.Row="0" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="1. AEC Discipline &amp; Category Scope" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock x:Name="TxtCategorySummary" Text="Select a discipline preset or customize categories below." FontSize="11" Foreground="#8D99AE"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbDisciplinePreset" Grid.Column="1" SelectionChanged="CmbDisciplinePreset_SelectionChanged">
                                    <ComboBoxItem Content="All Categories (Complete Model)" IsSelected="True"/>
                                    <ComboBoxItem Content="Architecture &amp; Interior"/>
                                    <ComboBoxItem Content="Structure &amp; Foundations"/>
                                    <ComboBoxItem Content="MEP &amp; Building Systems"/>
                                    <ComboBoxItem Content="Rooms, Spaces &amp; Areas"/>
                                    <ComboBoxItem Content="QTO &amp; Cost Estimation"/>
                                    <ComboBoxItem Content="Custom Category Selection"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <CheckBox x:Name="ChkExtractAllCategories" Content="Extract All Categories Found in Model (unrestricted)"
                                          IsChecked="True" FontWeight="SemiBold" Foreground="#6FFFE9"
                                          Checked="ChkExtractAllCategories_Changed" Unchecked="ChkExtractAllCategories_Changed"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Check All" Style="{StaticResource SmallBtn}" Margin="0,0,6,0" Click="BtnCheckAllCats_Click"/>
                                    <Button Content="Uncheck All" Style="{StaticResource SmallBtn}" Click="BtnUncheckAllCats_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#0B132B" CornerRadius="4" Padding="8,6" MaxHeight="115">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ItemsCategories">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                          Width="168" Margin="0,0,8,4" FontSize="11.5"
                                                          Checked="CategoryItem_Changed" Unchecked="CategoryItem_Changed"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. Parameter Scope & Priority Column Headers -->
                    <Border Grid.Row="1" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="2. Parameter Groups &amp; Flexible Column Headers" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <CheckBox x:Name="ChkExtractAllParams" Content="Extract All Model Parameters (Complete EAV Dump)"
                                          IsChecked="True" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#6FFFE9" Margin="0"/>
                            </Grid>

                            <WrapPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <CheckBox x:Name="ChkGrpIdentity" Content="Identity &amp; Classification (Mark, Type Mark, Keynote, IFC, OmniClass)" IsChecked="True"/>
                                <CheckBox x:Name="ChkGrpSpatial" Content="Spatial &amp; Location (Level, Room, Offset, Department)" IsChecked="True"/>
                                <CheckBox x:Name="ChkGrpQuantities" Content="Quantities / QTO (Area, Volume, Length, Width, Height, Thickness)" IsChecked="True"/>
                                <CheckBox x:Name="ChkGrpMaterials" Content="Materials &amp; Fire (Material, Structural Material, Fire Rating, Function)" IsChecked="True"/>
                                <CheckBox x:Name="ChkGrpMep" Content="MEP Systems (System Name, Classification, Size, Flow, Load, Panel)" IsChecked="True"/>
                                <CheckBox x:Name="ChkGrpLifecycle" Content="Workset &amp; Phasing (Workset, Phase Created, Design Option)" IsChecked="True"/>
                            </WrapPanel>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Priority Column Headers for Wide Table &amp; BI Export (comma-separated, editable per run):"
                                           FontSize="11" Foreground="#8D99AE" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Reset Default Headers" Style="{StaticResource SmallBtn}" Click="BtnResetHeaders_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="TxtPriorityColumns" Background="#0B132B" Foreground="#E2E8F0"
                                     BorderBrush="#2D3B60" BorderThickness="1" Padding="8,5" FontSize="11.5"
                                     TextWrapping="Wrap" MaxHeight="52" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Actions & Progress -->
                    <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnStartExtract" Grid.Column="0" Content="Extract Selected Models"
                                        Background="#00A896" Foreground="White" FontSize="13.5" FontWeight="Bold"
                                        Padding="14,10" Cursor="Hand" BorderThickness="0" Click="BtnStartExtract_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="BtnDashboard" Grid.Column="2" Content="Open Review Dashboard"
                                        Style="{StaticResource SecondaryBtn}" Padding="10,10" Click="BtnDashboard_Click"/>
                                <Button x:Name="BtnOpenOutputFolder" Grid.Column="4" Content="Open Output Folder"
                                        Style="{StaticResource SecondaryBtn}" Padding="12,10" Click="BtnOpenOutputFolder_Click"/>
                                <Button x:Name="BtnScheduleTask" Grid.Column="6" Content="Schedule Weekly Run"
                                        Style="{StaticResource SecondaryBtn}" Background="#1E3A5F" Foreground="#6FFFE9"
                                        Padding="12,10" Click="BtnScheduleTask_Click"
                                        ToolTip="Register or update a Windows Scheduled Task to run headless batch extraction automatically"/>
                            </Grid>

                            <ProgressBar x:Name="ProgBatch" Height="5" Background="#0B132B" Foreground="#00A896" BorderThickness="0" Margin="0,0,0,6"/>
                            <Grid>
                                <TextBlock x:Name="TxtProgressStatus" Text="Ready to extract..." FontSize="11" Foreground="#8D99AE" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkSkipUnchanged" Content="Skip unchanged model versions (Incremental Resume)"
                                          IsChecked="False" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. Console Output Terminal -->
                    <Border Grid.Row="3" Style="{StaticResource PanelCard}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Execution Console" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtLog" Grid.Row="1" Background="#050B18" Foreground="#64DFDF"
                                     FontFamily="Consolas" FontSize="11.5" IsReadOnly="True" BorderThickness="0"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Credentials & Hub Settings Modal Overlay -->
        <Grid x:Name="ModalSettings" Background="#B0050B18" Visibility="Collapsed">
            <Border Background="#1C2541" CornerRadius="8" Width="520" Padding="20" VerticalAlignment="Center"
                    BorderThickness="1" BorderBrush="#3A506B">
                <StackPanel>
                    <TextBlock Text="APS Credentials &amp; Hub Settings" FontSize="16" FontWeight="Bold" Foreground="#6FFFE9" Margin="0,0,0,4"/>
                    <TextBlock Text="Configure Client ID and Secret to authenticate and sync directly with Autodesk Construction Cloud."
                               FontSize="11.5" Foreground="#8D99AE" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <TextBlock Text="APS Client ID:" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtClientId" Background="#0B132B" Foreground="#FFFFFF" Padding="8,6" FontSize="12"
                             BorderBrush="#3A506B" Margin="0,0,0,12"/>

                    <TextBlock Text="APS Client Secret (Encrypted via Windows DPAPI):" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PwdClientSecret" Background="#0B132B" Foreground="#FFFFFF" Padding="8,6" FontSize="12"
                                 PasswordChar="●" BorderBrush="#3A506B" Margin="0,0,0,16"/>

                    <TextBlock x:Name="TxtModalStatus" Text="" FontSize="11.5" Foreground="#64DFDF" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnSaveSync" Grid.Column="0" Content="Save &amp; Sync with Hub"
                                Background="#00A896" Foreground="White" FontSize="12.5" FontWeight="Bold"
                                Padding="12,8" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0" Click="BtnSaveSync_Click">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnCloseModal" Grid.Column="1" Content="Close"
                                Style="{StaticResource SecondaryBtn}" Padding="16,8" Click="BtnCloseModal_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
